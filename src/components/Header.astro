---
import Search from 'virtual:starlight/components/Search';

const nav = [
  { label: '折腾', href: '/tinker/' },
  { label: '随笔', href: '/essay/' },
  { label: '索引', href: '/library/' },
  { label: '关于', href: '/about/' },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname === href || pathname.startsWith(href);
---

<div class="ink-bar">
  <div class="bar-left">
    <nav class="bar-nav" aria-label="站内导航">
      {
        nav.map((item) => (
          <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="bar-center">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 16c0-4.4 3.6-8 8-8s8 3.6 8 8" />
          <path d="M8 6.5 5.5 4M16 6.5 18.5 4" />
          <circle cx="9.5" cy="13" r="0.01" />
          <circle cx="14.5" cy="13" r="0.01" />
        </svg>
      </span>
      <span class="brand-text">Steroal</span>
    </a>
  </div>

  <div class="bar-actions">
    <div class="action-search"><Search /></div>

    <button class="icon-btn sound-btn" type="button" data-sound-toggle aria-pressed="false" title="开关音效" aria-label="开关音效">
      <svg class="ico-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 9.5h3L11.5 6v12L7 14.5H4z" />
        <path d="M15.5 9.2a4 4 0 0 1 0 5.6" />
        <path d="M18.2 6.8a7.5 7.5 0 0 1 0 10.4" />
      </svg>
      <svg class="ico-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 9.5h3L11.5 6v12L7 14.5H4z" />
        <path d="m16 10 4 4m0-4-4 4" />
      </svg>
    </button>

    <button class="icon-btn theme-btn" type="button" data-theme-toggle title="切换主题" aria-label="切换主题">
      <svg class="ico-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4" />
      </svg>
      <svg class="ico-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" />
      </svg>
    </button>

    <a class="icon-btn rss-btn" href="/rss.xml" title="RSS 订阅" aria-label="RSS 订阅">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 18.5a1.2 1.2 0 1 0 0-2.4 1.2 1.2 0 0 0 0 2.4z" fill="currentColor" stroke="none" />
        <path d="M4.5 11a8.5 8.5 0 0 1 8.5 8.5" />
        <path d="M4.5 5.5A14 14 0 0 1 18.5 19.5" />
      </svg>
    </a>
  </div>
</div>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var themeBtn = document.querySelector('[data-theme-toggle]');

    function currentTheme() {
      var attr = root.getAttribute('data-theme');
      if (attr === 'light' || attr === 'dark') return attr;
      return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    }

    /* ---------- 音效 ---------- */
    var SOUND_KEY = 'steroal-sound';
    var soundOn = false;
    try { soundOn = localStorage.getItem(SOUND_KEY) === 'on'; } catch (e) {}
    var audioCtx;

    function pop(freq) {
      if (!soundOn) return;
      try {
        var AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return;
        audioCtx = audioCtx || new AC();
        var t = audioCtx.currentTime;
        var osc = audioCtx.createOscillator();
        var gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq || 660, t);
        osc.frequency.exponentialRampToValueAtTime((freq || 660) * 0.72, t + 0.1);
        gain.gain.setValueAtTime(0.0001, t);
        gain.gain.exponentialRampToValueAtTime(0.05, t + 0.012);
        gain.gain.exponentialRampToValueAtTime(0.0001, t + 0.14);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start(t);
        osc.stop(t + 0.16);
      } catch (e) {}
    }

    if (themeBtn) {
      themeBtn.addEventListener('click', function () {
        var next = currentTheme() === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('starlight-theme', next); } catch (e) {}
        pop(next === 'dark' ? 420 : 620);
      });
    }

    var soundBtn = document.querySelector('[data-sound-toggle]');
    function syncSound() {
      if (!soundBtn) return;
      soundBtn.setAttribute('aria-pressed', soundOn ? 'true' : 'false');
      if (soundOn) soundBtn.classList.add('is-on'); else soundBtn.classList.remove('is-on');
    }
    if (soundBtn) {
      soundBtn.addEventListener('click', function () {
        soundOn = !soundOn;
        try { localStorage.setItem(SOUND_KEY, soundOn ? 'on' : 'off'); } catch (e) {}
        syncSound();
        pop(880);
      });
    }
    syncSound();

    /* ---------- 悬停与点击的轻响 ---------- */
    document.addEventListener('pointerenter', function (e) {
      var el = e.target && e.target.closest ? e.target.closest('a, button') : null;
      if (el) pop(760);
    }, true);
    document.addEventListener('click', function (e) {
      var el = e.target && e.target.closest ? e.target.closest('a, button') : null;
      if (el) pop(560);
    }, true);
  })();
</script>

<style>
  .ink-bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 100%;
    gap: 1rem;
  }

  .bar-center {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    justify-self: center;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.5rem;
    border-radius: 999px;
    text-decoration: none !important;
    color: var(--sl-color-text);
    transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .brand:hover {
    transform: translateY(-1px) rotate(-1.2deg);
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 1.65rem;
    height: 1.65rem;
    border-radius: 9px;
    background: linear-gradient(140deg, var(--sl-color-accent), #c04bb4 70%, #f0a35e);
    color: #fff;
    box-shadow: 0 4px 12px -6px color-mix(in srgb, var(--sl-color-accent) 70%, transparent);
  }

  .brand-mark svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  .brand-text {
    font-size: 1.12rem;
    font-weight: 720;
    letter-spacing: -0.03em;
  }

  .bar-left {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .bar-nav {
    display: flex;
    align-items: center;
    gap: 0.1rem;
  }

  .nav-link {
    position: relative;
    padding: 0.32rem 0.62rem;
    border-radius: 999px;
    font-size: 0.9rem;
    color: var(--sl-color-gray-2);
    text-decoration: none !important;
    transition: color 0.18s ease, background-color 0.18s ease;
  }

  .nav-link:hover {
    color: var(--sl-color-text);
    background: color-mix(in srgb, var(--sl-color-accent) 9%, transparent);
  }

  .nav-link.active {
    color: var(--sl-color-accent);
    font-weight: 620;
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    inset-inline: 0.62rem;
    bottom: 0.12rem;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }

  .bar-actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.05rem;
  }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--sl-color-gray-2);
    cursor: pointer;
    transition: background-color 0.18s ease, color 0.18s ease, transform 0.24s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .icon-btn:hover {
    background: color-mix(in srgb, var(--sl-color-accent) 9%, transparent);
    color: var(--sl-color-accent);
    transform: translateY(-1px) scale(1.06);
  }

  .icon-btn:active {
    transform: scale(0.94);
  }

  .icon-btn svg {
    width: 1.22rem;
    height: 1.22rem;
  }

  /* 声音按钮：默认显示「静音」图标 */
  .sound-btn .ico-on {
    display: none;
  }
  .sound-btn.is-on .ico-on {
    display: block;
  }
  .sound-btn.is-on .ico-off {
    display: none;
  }

  /* 主题按钮：浅色显示太阳，深色显示月亮 */
  :root[data-theme='dark'] .theme-btn .ico-sun {
    display: none;
  }
  :root:not([data-theme='dark']) .theme-btn .ico-moon {
    display: none;
  }

  /* 搜索按钮改成图标 */
  .action-search :global(site-search) {
    display: contents;
  }

  .action-search :global(button[data-open-modal]) {
    display: inline-grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    padding: 0;
    border: 0 !important;
    border-radius: 50%;
    background: transparent !important;
    color: var(--sl-color-gray-2);
    font-size: 0;
    transition: background-color 0.18s ease, color 0.18s ease, transform 0.24s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .action-search :global(button[data-open-modal]:hover) {
    background: color-mix(in srgb, var(--sl-color-accent) 9%, transparent) !important;
    color: var(--sl-color-accent);
    transform: translateY(-1px) scale(1.06);
  }

  .action-search :global(button[data-open-modal] svg) {
    width: 1.22rem;
    height: 1.22rem;
  }

  .action-search :global(button[data-open-modal] > span),
  .action-search :global(button[data-open-modal] > kbd) {
    display: none !important;
  }

  @media (max-width: 46rem) {
    .bar-nav {
      display: none;
    }
  }

  @media (max-width: 40rem) {
    .rss-btn {
      display: none;
    }
    .brand-text {
      font-size: 1.02rem;
    }
  }
</style>
