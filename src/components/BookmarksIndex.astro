---
import data from '../data/bookmarks.json';

const { total, kept, excluded, generatedAt, sources, groups } = data;

/** 把一个分组里的书签按域名聚成簇，多的排前面 */
const cluster = (items: { title: string; url: string; host: string }[]) => {
  const map = new Map<string, typeof items>();
  for (const item of items) {
    if (!map.has(item.host)) map.set(item.host, []);
    map.get(item.host)!.push(item);
  }
  return [...map.entries()]
    .map(([host, list]) => ({ host, list }))
    .sort((a, b) => b.list.length - a.list.length || a.host.localeCompare(b.host));
};

const view = groups.map((g) => {
  const clusters = cluster(g.items);
  return {
    name: g.name,
    count: g.items.length,
    main: clusters.slice(0, 10),
    tail: clusters.slice(10),
    tailCount: clusters.slice(10).reduce((n, c) => n + c.list.length, 0),
  };
});

const excludedTotal = excluded.招聘网站 + excluded.敏感目录 + excluded.内网或本地;
---

<div class="bm not-content">
  <div class="bm-stats">
    <div class="stat"><b>{total}</b><span>原始条目</span></div>
    <div class="stat"><b>{kept}</b><span>去重后保留</span></div>
    <div class="stat"><b>{excluded.重复}</b><span>重复的</span></div>
    <div class="stat"><b>{excludedTotal}</b><span>主动排除</span></div>
    <div class="stat"><b>{groups.length}</b><span>个分组</span></div>
  </div>

  <p class="bm-meta">
    抓取自 {sources.map((s) => `${s.browser}（${s.count} 条）`).join('、')}，生成于 {generatedAt}。
  </p>

  <div class="bm-toolbar">
    <label class="bm-search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <circle cx="11" cy="11" r="6.5" />
        <path d="m16 16 4 4" />
      </svg>
      <input type="search" placeholder="搜标题或域名，比如「stm32」「github」" data-bm-search />
    </label>
    <span class="bm-count" data-bm-count>{kept} 条</span>
  </div>

  <div class="bm-chips">
    <button class="chip is-active" data-group="全部" type="button">全部</button>
    {
      view.map((g) => (
        <button class="chip" data-group={g.name} type="button">
          {g.name}
        </button>
      ))
    }
  </div>

  {
    view.map((group) => (
      <section class="bm-group" data-group-name={group.name}>
        <h2 class="bm-group-title">
          {group.name}
          <span>{group.count}</span>
        </h2>

        {group.main.map((c) => (
          <details class="bm-cluster">
            <summary>
              <span class="host">{c.host}</span>
              <span class="num">×{c.list.length}</span>
            </summary>
            <div class="bm-list">
              {c.list.map((item) => (
                <a
                  class="bm-item"
                  href={item.url}
                  target="_blank"
                  rel="noopener"
                  data-text={`${item.title} ${item.host}`.toLowerCase()}
                >
                  {item.title}
                </a>
              ))}
            </div>
          </details>
        ))}

        {group.tail.length > 0 && (
          <details class="bm-cluster bm-tail">
            <summary>
              <span class="host">其他 {group.tail.length} 个站点</span>
              <span class="num">×{group.tailCount}</span>
            </summary>
            <div class="bm-list">
              {group.tail.flatMap((c) =>
                c.list.map((item) => (
                  <a
                    class="bm-item"
                    href={item.url}
                    target="_blank"
                    rel="noopener"
                    data-text={`${item.title} ${item.host}`.toLowerCase()}
                  >
                    <span class="tail-host">{item.host}</span>
                    {item.title}
                  </a>
                ))
              )}
            </div>
          </details>
        )}
      </section>
    ))
  }

  <p class="bm-empty" data-bm-empty hidden>没有匹配的条目。</p>
</div>

<script>
  const root = document.querySelector<HTMLElement>('.bm');
  if (root) {
    const input = root.querySelector<HTMLInputElement>('[data-bm-search]');
    const countEl = root.querySelector<HTMLElement>('[data-bm-count]');
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('.chip'));
    const items = Array.from(root.querySelectorAll<HTMLAnchorElement>('.bm-item'));
    const sections = Array.from(root.querySelectorAll<HTMLElement>('.bm-group'));
    const clusters = Array.from(root.querySelectorAll<HTMLDetailsElement>('.bm-cluster'));
    const empty = root.querySelector<HTMLElement>('[data-bm-empty]');

    // 记住每个域名簇默认是开还是关
    const initialOpen = new Map<HTMLDetailsElement, boolean>();
    clusters.forEach((d) => initialOpen.set(d, d.open));

    let active = '全部';

    const apply = () => {
      const q = (input?.value ?? '').trim().toLowerCase();
      let visible = 0;

      for (const item of items) {
        const group = item.closest<HTMLElement>('.bm-group')?.dataset.groupName ?? '';
        const ok = (active === '全部' || group === active) && (!q || (item.dataset.text ?? '').includes(q));
        item.hidden = !ok;
        if (ok) visible++;
      }

      for (const details of clusters) {
        const any = Array.from(details.querySelectorAll<HTMLAnchorElement>('.bm-item')).some((i) => !i.hidden);
        details.hidden = !any;
        // 搜索时自动展开命中的簇，清空后再恢复默认
        details.open = any && (q ? true : initialOpen.get(details) ?? false);
      }

      for (const section of sections) {
        const any = Array.from(section.querySelectorAll<HTMLAnchorElement>('.bm-item')).some((i) => !i.hidden);
        section.hidden = !any;
      }

      if (countEl) countEl.textContent = `${visible} 条`;
      if (empty) empty.hidden = visible !== 0;
    };

    input?.addEventListener('input', apply);
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        active = chip.dataset.group ?? '全部';
        chips.forEach((c) => c.classList.toggle('is-active', c === chip));
        apply();
      });
    }
  }
</script>

<style>
  .bm {
    margin-block: 1.5rem 3rem;
  }

  .bm-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    gap: 0.6rem;
    margin-bottom: 0.9rem;
  }

  .stat {
    padding: 0.85rem 0.9rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 14px;
    background: var(--sl-color-bg-nav);
    text-align: center;
  }

  .stat b {
    display: block;
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--sl-color-accent);
    font-variant-numeric: tabular-nums;
  }

  .stat span {
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
  }

  .bm-meta {
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--sl-color-gray-4);
    margin-bottom: 1.4rem;
  }

  .bm-toolbar {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.8rem;
  }

  .bm-search {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1;
  }

  .bm-search svg {
    position: absolute;
    left: 0.8rem;
    width: 1.05rem;
    height: 1.05rem;
    color: var(--sl-color-gray-4);
    pointer-events: none;
  }

  .bm-search input {
    width: 100%;
    padding: 0.6rem 0.9rem 0.6rem 2.4rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-text);
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .bm-search input:focus {
    border-color: var(--sl-color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--sl-color-accent) 14%, transparent);
  }

  .bm-count {
    font-size: 0.8rem;
    color: var(--sl-color-gray-4);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .bm-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.6rem;
  }

  .chip {
    padding: 0.32rem 0.78rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
    background: transparent;
    color: var(--sl-color-gray-2);
    font-size: 0.82rem;
    transition: background-color 0.18s ease, color 0.18s ease, border-color 0.18s ease,
      transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .chip:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--sl-color-accent) 45%, transparent);
    color: var(--sl-color-accent);
  }

  .chip.is-active {
    background: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
    color: #fff;
  }

  .bm-group {
    margin-bottom: 1.8rem;
  }

  .bm-group-title {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 0.7rem;
    padding: 0;
    border: 0;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-pink);
  }

  .bm-group-title span {
    font-size: 0.72rem;
    color: var(--sl-color-gray-4);
    letter-spacing: 0;
  }

  .bm-cluster {
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 10px;
    margin-bottom: 0.35rem;
    background: var(--sl-color-bg-nav);
  }

  .bm-cluster summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.42rem 0.7rem;
    list-style: none;
    font-size: 0.82rem;
    color: var(--sl-color-gray-2);
  }

  .bm-cluster summary::-webkit-details-marker,
  .bm-cluster summary::marker {
    display: none;
    content: '';
  }

  .bm-cluster summary::after {
    content: '+';
    margin-inline-start: auto;
    color: var(--sl-color-gray-4);
    transition: transform 0.2s ease;
  }

  .bm-cluster[open] summary::after {
    transform: rotate(45deg);
  }

  .bm-cluster summary:hover {
    color: var(--sl-color-accent);
  }

  .host {
    font-family: var(--sl-font-mono);
    font-size: 0.78rem;
  }

  .num {
    font-size: 0.72rem;
    color: var(--sl-color-gray-4);
    font-variant-numeric: tabular-nums;
  }

  .bm-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 0 1.2rem;
    padding: 0.2rem 0.7rem 0.6rem;
    border-top: 1px dashed var(--sl-color-hairline-light);
    margin-top: 0.1rem;
  }

  .bm-item {
    display: block;
    padding: 0.32rem 0.35rem;
    border-radius: 6px;
    font-size: 0.84rem;
    color: var(--sl-color-gray-2);
    text-decoration: none !important;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .bm-item:hover {
    background: color-mix(in srgb, var(--sl-color-accent) 7%, transparent);
    color: var(--sl-color-accent);
  }

  .tail-host {
    display: inline-block;
    min-width: 7.5rem;
    margin-inline-end: 0.5rem;
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    color: var(--sl-color-gray-4);
  }

  .bm-tail .bm-list {
    grid-template-columns: 1fr;
  }

  .bm-empty {
    padding: 2rem 0;
    text-align: center;
    color: var(--sl-color-gray-3);
  }

  [hidden] {
    display: none !important;
  }

  @media (max-width: 40rem) {
    .bm-list {
      grid-template-columns: 1fr;
    }
  }
</style>
