---
const { data } = Astro.locals.starlightRoute.entry;
const hero = data.hero ?? {};
const title = hero.title ?? data.title;
const tagline = hero.tagline;
const actions = hero.actions ?? [];

// 彩虹弧：半径从内到外递增，颜色由靛蓝过渡到暖橙
const palette = [
  '#3b3bd6',
  '#4a44e0',
  '#5c50e8',
  '#7058ec',
  '#8a5fe8',
  '#a463e0',
  '#bd67d2',
  '#d26abf',
  '#e26da7',
  '#ec728f',
  '#f27c78',
  '#f58a63',
];
const arcs = palette.map((color, i) => ({
  color,
  r: 150 + i * 17,
}));
---

<section class="sky">
  <div class="sky-wash"></div>

  <div class="cloud cloud-a"></div>
  <div class="cloud cloud-b"></div>
  <div class="cloud cloud-c"></div>

  <svg class="rainbow" viewBox="0 0 1000 420" preserveAspectRatio="xMidYMax meet" aria-hidden="true">
    {
      arcs.map(({ color, r }, i) => (
        <path
          d={`M ${500 - r} 470 A ${r} ${r} 0 0 1 ${500 + r} 470`}
          fill="none"
          stroke={color}
          stroke-width="10"
          stroke-linecap="round"
          stroke-dasharray="11 15"
          style={`--i:${i}`}
        />
      ))
    }
  </svg>

  <div class="hill"></div>

  <svg class="cat" viewBox="0 0 140 150" aria-hidden="true">
    <ellipse cx="70" cy="143" rx="46" ry="6" fill="rgba(28,27,34,.12)" />
    <path d="M104 141c24-1 27-17 21-31" fill="none" stroke="#3a3550" stroke-width="13" stroke-linecap="round" />
    <path d="M28 144c-5-30 3-60 22-72 6-4 13-6 20-6s14 2 20 6c19 12 27 42 22 72z" fill="#3a3550" />
    <ellipse cx="70" cy="122" rx="22" ry="18" fill="#fff6e9" opacity=".92" />
    <ellipse cx="51" cy="141" rx="11" ry="7" fill="#fff6e9" />
    <ellipse cx="89" cy="141" rx="11" ry="7" fill="#fff6e9" />
    <path d="M40 44 44 18 66 33Z" fill="#3a3550" />
    <path d="M100 44 96 18 74 33Z" fill="#3a3550" />
    <path d="M44 26 46 36 57 33Z" fill="#f3a6b8" />
    <path d="M96 26 94 36 83 33Z" fill="#f3a6b8" />
    <circle cx="70" cy="62" r="33" fill="#3a3550" />
    <path d="M55 60q6 7 12 0" fill="none" stroke="#fff6e9" stroke-width="3.4" stroke-linecap="round" />
    <path d="M73 60q6 7 12 0" fill="none" stroke="#fff6e9" stroke-width="3.4" stroke-linecap="round" />
    <path d="M67 72h6l-3 4z" fill="#f3a6b8" />
    <path d="M70 76v4M70 80q-5 4-9 1M70 80q5 4 9 1" fill="none" stroke="#fff6e9" stroke-width="2.4" stroke-linecap="round" />
    <path d="M36 66h-9M36 72l-9 3M104 66h9M104 72l9 3" stroke="#fff6e9" stroke-width="2" stroke-linecap="round" opacity=".75" />
  </svg>

  <span class="spark s1"></span>
  <span class="spark s2"></span>
  <span class="spark s3"></span>
</section>

<div class="hero-copy">
  <h1 class="hero-title">{title}</h1>
  {tagline && <p class="hero-tagline">{tagline}</p>}
  {
    actions.length > 0 && (
      <div class="hero-actions">
        {actions.map((a, i) => (
          <a class:list={['hero-btn', a.variant === 'minimal' ? 'ghost' : 'solid']} href={a.link}>
            {a.text}
            {i === 0 && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h13M13 6l6 6-6 6" />
              </svg>
            )}
          </a>
        ))}
      </div>
    )
  }
</div>

<style>
  /* ---------------- 天空 ---------------- */
  .sky {
    position: relative;
    height: clamp(240px, 32vw, 380px);
    margin-block: 0 2.4rem;
    border-radius: 26px;
    overflow: hidden;
    box-shadow: var(--ink-shadow);
    isolation: isolate;
    animation: skyIn 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .sky-wash {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--ink-sky-from) 0%, var(--ink-sky-from) 38%, var(--ink-sky-to) 100%);
  }

  :global(:root[data-theme='dark']) .sky-wash {
    background: linear-gradient(180deg, var(--ink-sky-from) 0%, var(--ink-sky-from) 30%, var(--ink-sky-to) 100%);
  }

  /* ---------------- 云 ---------------- */
  .cloud {
    position: absolute;
    width: 110px;
    height: 46px;
    border-radius: 46px;
    background: #eaf6ff;
    opacity: 0.72;
    animation: drift 22s ease-in-out infinite alternate;
  }

  .cloud::before,
  .cloud::after {
    content: '';
    position: absolute;
    background: inherit;
    border-radius: 50%;
  }

  .cloud::before {
    width: 54px;
    height: 54px;
    left: 16px;
    top: -24px;
  }

  .cloud::after {
    width: 38px;
    height: 38px;
    right: 18px;
    top: -16px;
  }

  .cloud-a {
    left: 4%;
    top: 26%;
    transform: scale(1.5);
    animation-duration: 28s;
  }

  .cloud-b {
    right: 6%;
    top: 18%;
    transform: scale(1.1);
    opacity: 0.5;
    animation-duration: 34s;
    animation-direction: alternate-reverse;
  }

  .cloud-c {
    left: 38%;
    top: 10%;
    transform: scale(0.8);
    opacity: 0.42;
    animation-duration: 40s;
  }

  :global(:root[data-theme='dark']) .cloud {
    background: #2b4a5e;
    opacity: 0.5;
  }

  /* ---------------- 彩虹 ---------------- */
  .rainbow {
    position: absolute;
    inset-inline: 0;
    bottom: 6%;
    width: 100%;
    height: 88%;
  }

  .rainbow path {
    transform-box: view-box;
    transform-origin: 500px 470px;
    opacity: 0;
    animation: arcIn 1s cubic-bezier(0.22, 0.9, 0.28, 1) both;
    animation-delay: calc(var(--i) * 55ms + 120ms);
  }

  /* 底部渐隐，让天空融进页面背景 */
  .sky::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 34%;
    background: linear-gradient(to bottom, transparent, var(--sl-color-bg) 92%);
    pointer-events: none;
    z-index: 3;
  }

  /* ---------------- 猫 ---------------- */
  .cat {
    position: absolute;
    left: 50%;
    bottom: 2%;
    width: clamp(88px, 12vw, 132px);
    translate: -50% 0;
    z-index: 4;
    filter: drop-shadow(0 8px 16px rgba(40, 36, 70, 0.16));
    --spring: linear(
      0, 0.005, 0.02 2%, 0.08 4.4%, 0.47 15%, 0.568, 0.651, 0.723 24.2%, 0.785,
      0.837 30.9%, 0.879 34.6%, 0.915 38.9%, 0.943 43.6%, 0.964 48.9%, 0.98 55.1%,
      0.989 62.1%, 0.995 70.9%, 1
    );
    animation: catIn 0.833s 0.5s var(--spring) both;
  }

  .cat > * {
    transform-box: view-box;
    transform-origin: 70px 140px;
  }

  .cat {
    transform-origin: 50% 100%;
  }

  :global(:root[data-theme='dark']) .cat {
    filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.5));
  }

  /* ---------------- 光点 ---------------- */
  .spark {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fff;
    opacity: 0.85;
    animation: twinkle 3.2s ease-in-out infinite;
    z-index: 2;
  }

  .s1 {
    left: 18%;
    top: 40%;
    animation-delay: 0.2s;
  }

  .s2 {
    right: 22%;
    top: 30%;
    width: 4px;
    height: 4px;
    animation-delay: 1.1s;
  }

  .s3 {
    right: 34%;
    top: 52%;
    width: 5px;
    height: 5px;
    animation-delay: 2s;
  }

  /* ---------------- 标题区 ---------------- */
  .hero-copy {
    text-align: center;
    padding-block: 0.4rem 1.8rem;
  }

  .hero-title {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 3.9rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
    font-weight: 760;
    background: linear-gradient(96deg, var(--sl-color-text) 16%, var(--sl-color-accent) 62%, var(--ink-pink) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: upIn 0.7s 0.12s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .hero-tagline {
    max-width: 34rem;
    margin: 1rem auto 0;
    font-size: 1.06rem;
    line-height: 1.85;
    color: var(--sl-color-gray-2);
    animation: upIn 0.7s 0.2s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
    margin-top: 1.7rem;
    animation: upIn 0.7s 0.3s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.62rem 1.25rem;
    border-radius: 999px;
    font-size: 0.94rem;
    font-weight: 600;
    text-decoration: none !important;
    transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.22s ease,
      border-color 0.2s ease, color 0.2s ease;
  }

  .hero-btn svg {
    width: 1.05rem;
    height: 1.05rem;
    transition: transform 0.22s ease;
  }

  .hero-btn:hover svg {
    transform: translateX(3px);
  }

  .hero-btn.solid {
    color: #fff !important;
    background: linear-gradient(135deg, var(--sl-color-accent), #2c0b8e);
    box-shadow: 0 10px 24px -14px color-mix(in srgb, var(--sl-color-accent) 90%, transparent);
  }

  .hero-btn.solid:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 32px -16px color-mix(in srgb, var(--sl-color-accent) 90%, transparent);
  }

  .hero-btn.ghost {
    color: var(--sl-color-text) !important;
    border: 1px solid var(--sl-color-hairline);
    background: var(--sl-color-bg-nav);
  }

  .hero-btn.ghost:hover {
    transform: translateY(-2px);
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent) !important;
  }

  /* ---------------- 关键帧 ---------------- */
  @keyframes skyIn {
    from {
      opacity: 0;
      transform: scale(0.985);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes arcIn {
    from {
      opacity: 0;
      transform: scale(0.88);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes catIn {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.9);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes upIn {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes drift {
    from {
      translate: -12px 0;
    }
    to {
      translate: 18px 0;
    }
  }

  @keyframes twinkle {
    0%,
    100% {
      opacity: 0.15;
      transform: scale(0.7);
    }
    50% {
      opacity: 0.9;
      transform: scale(1.2);
    }
  }

  @media (max-width: 40rem) {
    .sky {
      border-radius: 18px;
      height: 210px;
    }
    .cloud-a {
      transform: scale(1);
    }
    .cloud-b {
      transform: scale(0.85);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sky,
    .sky *,
    .hero-title,
    .hero-tagline,
    .hero-actions {
      animation: none !important;
    }
  }
</style>
